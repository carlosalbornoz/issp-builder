  "part1": {
    "legalBasis": "Republic Act No. 11877, converting the Municipality of Malinaw into a component city, with full corporate powers for local governance and service delivery.",
    "mandateFunction": "The City Government of Malinaw delivers local governance services for 42 barangays: business permits and licensing, real property taxation, civil registry, health services, social welfare and disaster response, supported by a city hall workforce of roughly 600 personnel.",
    "visionStatement": "A city where every government service that can be online is online — and works.",
    "missionStatement": "To deliver fast, transparent city services through integrated digital systems that citizens can use from any barangay.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Faster, more transparent business and property transactions",
        "programs": [
          {
            "id": "oo-1-pg-1",
            "name": "One-Stop Digital Services Program"
          }
        ]
      },
      {
        "id": "oo-2",
        "name": "Connected barangays",
        "programs": [
