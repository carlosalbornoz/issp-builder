  "part2": {
    "strategicConcerns": [
      {
        "id": "c-1",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-1"
        ],
        "criticalSystem": "eBPLS (vendor-hosted business permits)",
        "concern": "The vendor-hosted permit system's data exports cost extra and arrive as PDFs; the city cannot do its own analytics on its own permit data, and renewals queue twice — once to file, once to pay.",
        "desiredStrategy": "Bring permits into the city-owned One-Stop portal with integrated payment and open data exports."
      },
      {
        "id": "c-2",
        "outcomeIds": [
          "oo-2"
        ],
        "programIds": [
          "oo-2-pg-2"
        ],
        "criticalSystem": "Barangay reporting (personal hotspots)",
        "concern": "Nineteen barangays submit reports through councilors' personal hotspots; during the last flood, three barangays' damage reports arrived two days late because the hotspots were in the flood.",
        "desiredStrategy": "Deploy a barangay mesh connectivity network with solar-powered nodes and city-managed backhaul."
      },
      {
        "id": "c-3",
        "outcomeIds": [
          "oo-3"
        ],
        "programIds": [
          "oo-3-pg-3"
        ],
        "criticalSystem": "City incident management (group chat)",
        "concern": "Disaster response coordination runs on a group chat; situation reports are screenshots, and the RAPIDE hazard feed the city is entitled to has never been integrated.",
        "desiredStrategy": "Stand up a city incident dashboard consuming RAPIDE feeds and barangay mesh reports."
      }
    ],
    "networkDiagrams": [],
    "networkDescription": "City hall runs a single flat network shared by admin offices and the public Wi-Fi; the business permit system is hosted by its vendor with data exports available on request (and a fee); real property tax records live in an Access database backed up to the treasurer's personal external drive. Of 42 barangays, 19 have no city-provided connectivity and use councilors' personal hotspots for submissions.",
