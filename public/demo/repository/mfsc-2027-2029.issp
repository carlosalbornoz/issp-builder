  "part1": {
    "legalBasis": "Executive Order No. 914 (s. 2023), incorporating the Metro Ferry Systems Corporation under the Office of the President to operate the metro ferry network piers, vessels and fare systems as one integrated public transport service.",
    "mandateFunction": "MFSC operates 48 passenger vessels across 14 piers on the metro ferry network: fare collection, pier maintenance, fleet operations, safety compliance, and the ferry commons program that keeps fares integrated with other metro transport. It earns fare and retail income and receives corporate subsidies for service obligations.",
    "visionStatement": "A ferry network people can trust with their commute: tap-and-go boarding, live arrivals, and vessels that sail on schedule.",
    "missionStatement": "To run safe, punctual, and financially sustainable ferry services with modern ticketing and fleet intelligence.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Seamless, trusted fare collection",
