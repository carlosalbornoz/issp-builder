  "part2": {
    "strategicConcerns": [
      {
        "id": "c-1",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-1"
        ],
        "criticalSystem": "FERRYCARD AFC (automated fare collection)",
        "concern": "The 2014 vendor-locked AFC charges license fees rising 9% yearly, cannot support account-based ticketing or QR, and its reconciliation runs T+3 — conductors cash up against estimates. One in 400 card taps fails at legacy validators.",
        "desiredStrategy": "Deploy an open, account-based ticketing stack with mobile QR and instant settlement (Project BIYAHE), and retire per-transaction licensing."
      },
      {
        "id": "c-2",
        "outcomeIds": [
          "oo-2"
        ],
        "programIds": [
          "oo-2-pg-2"
        ],
        "criticalSystem": "Fleet maintenance planning (whiteboard)",
        "concern": "Vessel maintenance is planned from a photographed whiteboard; two avoidable engine failures in 2025 were traced to parts that were on order but not visible to the planning meeting.",
        "desiredStrategy": "Instrument the fleet with telemetry and deploy fleet health analytics (Project DALOY) so parts, hours and defects are planned from data."
      },
      {
        "id": "c-3",
        "outcomeIds": [
          "oo-3"
        ],
        "programIds": [
          "oo-3-pg-3"
        ],
        "criticalSystem": "Pier connectivity (patchwork broadband)",
        "concern": "Pier POS and validators share consumer broadband; when the mall Wi-Fi blinks, two piers drop to offline mode and reconcile next day — the source of most cash-up variances.",
        "desiredStrategy": "Give every pier resilient dedicated connectivity with automatic failover (Pier Network Connectivity project)."
      }
    ],
    "networkDiagrams": [],
    "networkDescription": "The fare collection system is a 2014 vendor-locked account-based stack whose license fees grow 9% a year; validators at older piers run firmware from 2018 and fail card reads roughly once every 400 taps, which staff resolve by waving passengers through. Pier connectivity is a patchwork of consumer broadband; two piers run on the mall Wi-Fi next door. Fleet maintenance planning happens on a whiteboard photographed each Monday.",
