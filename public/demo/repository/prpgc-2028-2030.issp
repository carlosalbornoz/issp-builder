  "part1": {
    "legalBasis": "Republic Act No. 11997 (Renewable Energy Finance Act of 2024), creating the Philippine Renewable Power Guarantee Corporation to provide guarantees and credit enhancement that crowd in private financing for renewable energy projects.",
    "mandateFunction": "The PRPGC issues payment and completion guarantees for qualified renewable energy projects, manages a portfolio of guaranteed exposures, prices guarantee fees actuarially, and reports on portfolio quality to its shareholder departments and the market.",
    "visionStatement": "Renewable energy projects financed faster because a credible public guarantee stands behind them.",
    "missionStatement": "To provide rigorous, transparent and financially sustainable guarantee products that accelerate the renewable energy buildout.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Faster guarantee issuance for qualified RE projects",
        "programs": [
          {
            "id": "oo-1-pg-1",
            "name": "Guarantee Digitization Program"
          }
        ]
      },
      {
        "id": "oo-2",
        "name": "World-class portfolio risk analytics",
        "programs": [
          {
            "id": "oo-2-pg-1",
            "name": "Portfolio Analytics Program"
          }
        ]
      },
      {
        "id": "oo-3",
        "name": "Sustainable and secure operations",
        "programs": [
          {
            "id": "oo-3-pg-1",
            "name": "Operating Resilience Program"
          }
        ]
      }
    ],
    "cioName": "VP Cecilia M. Lambino",
