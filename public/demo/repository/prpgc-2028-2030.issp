  "part2": {
    "strategicConcerns": [
      {
        "id": "c-1",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-1"
        ],
        "criticalSystem": "GATE (Guarantee Administration & Tracking Environment)",
        "concern": "Guarantee issuance runs through GATE's 22 manual workflow steps and three wet signatures; the median time from complete application to issued guarantee is 94 days, and sponsors often close financing before the guarantee does.",
        "desiredStrategy": "Rebuild guarantee workflows end-to-end (Project WATTS) with straight-through processing for standard products and digital signatures."
      },
      {
        "id": "c-2",
        "outcomeIds": [
          "oo-2"
        ],
        "programIds": [
          "oo-2-pg-2"
        ],
        "criticalSystem": "Risk models (desktop statistical software)",
        "concern": "Exposure and pricing models run on desktop software on individual workstations; a model change cannot be reproduced six months later, and the portfolio cube takes twenty minutes to recalculate.",
        "desiredStrategy": "Stand up the Renewables Portfolio Data Platform: versioned models, governed data, and portfolio analytics that recalculate in seconds."
      }
    ],
    "networkDiagrams": [],
    "networkDescription": "The Corporation operates from one head office. The GATE guarantee system runs on-premise under an outsourced maintenance contract whose knowledge base is effectively two named engineers; risk models run in desktop statistical software, and the exposure portfolio is tracked in a spreadsheet cube maintained by the risk department that takes twenty minutes to recalculate.",
