    "internalProjects": [
      {
        "id": "p-watts",
        "title": "Project WATTS — Workflows for Account Tracking & Surety",
        "description": "Rebuilds guarantee workflows end-to-end: digital application intake, straight-through processing for standard products, digital signatures and claims servicing — cutting issuance from 94 days to 20.",
        "objectives": "1. WATTS live for standard guarantee products by 2029\n2. Median issuance time: 20 days\n3. Digital signature accepted for all guarantee documents\n4. GATE decommissioned by 2029",
        "projectType": "IS_DRIVEN",
        "linkedSystemIds": [
          "ps-watts"
        ],
        "strategicAlignment": [
          "E-Government Master Plan",
          "National Cybersecurity Plan"
        ],
        "harmonizationFramework": [
          "National Prioritization",
          "Resource Optimization"
        ],
        "implementingUnit": "ICT and Data Division",
        "fundingSource": "General Appropriations Act",
        "year1Deliverables": "Intake and straight-through processing live for two standard products; digital signatures live",
        "year2Deliverables": "Full product suite migrated; claims servicing live; GATE decommissioned",
        "year3Deliverables": "",
        "duration": "2028–2029"
      },
      {
        "id": "p-portfolio",
        "title": "Renewables Portfolio Data Platform",
        "description": "Builds the governed exposure data platform with versioned risk models and portfolio analytics, replacing the twenty-minute spreadsheet cube.",
        "objectives": "1. Platform live with full exposure history by 2028\n2. Versioned, reviewable model runs\n3. Portfolio recalculation in seconds",
        "projectType": "IS_DRIVEN",
        "linkedSystemIds": [
          "ps-portfolio"
        ],
        "strategicAlignment": [
          "Public Investment Program"
        ],
        "harmonizationFramework": [
          "Resource Optimization",
          "Scalability and Sustainability"
        ],
        "implementingUnit": "Risk Management Division",
        "fundingSource": "General Appropriations Act",
        "year1Deliverables": "Exposure history migrated; first versioned model runs",
        "year2Deliverables": "Portfolio analytics live; cube retired",
        "year3Deliverables": "Stress-testing environment operational",
        "duration": "2028–2030"
      }
    ],
