  "part1": {
    "legalBasis": "Republic Act No. 12021 (Coastal Resilience Act of 2025), establishing the National Coastal Resilience Authority to unify sea-level, storm surge and coastal hazard monitoring, and to operate the national community early warning system for coastal areas.",
    "mandateFunction": "The NCRA operates the national coastal hazard monitoring network, produces official storm surge and coastal flood forecasts, runs the community early warning system for 832 coastal municipalities, and maintains the national coastal hazard data infrastructure. It coordinates closely with the national disaster risk reduction council, meteorological services, and local government units.",
    "visionStatement": "Zero-surprise coastal hazards: every at-risk barangay warned in time, every decision backed by live coastal data.",
    "missionStatement": "To monitor, model and communicate coastal hazards with authoritative, timely, and openly accessible data.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Reduced loss of life and property in coastal hazard events",
        "programs": [
          {
            "id": "oo-1-pg-1",
            "name": "Community Early Warning Program"
          },
          {
            "id": "oo-1-pg-2",
            "name": "Hazard Intelligence Program"
          }
        ]
      },
