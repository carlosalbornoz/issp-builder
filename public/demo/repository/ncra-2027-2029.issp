  "part2": {
    "strategicConcerns": [
      {
        "id": "c-1",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-1"
        ],
        "criticalSystem": "CHIMES (Coastal Hazard Integration & Monitoring Enterprise System)",
        "concern": "CHIMES ingests sensor data in overnight batches, so warning desks work from projections up to eleven hours old. During Typhoon Barangas the surge height at San Vicente reef was underestimated because the 03:00 reading arrived after the 06:00 briefing had been issued.",
        "desiredStrategy": "Replace CHIMES with the streaming AWARE platform (Project SIGWA): real-time ingestion, model runs every ten minutes, and warning products generated in minutes, not shifts."
      },
      {
        "id": "c-2",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-2"
        ],
        "criticalSystem": "Community warning dissemination (manual cascades)",
        "concern": "Warnings reach barangays through a cascade of text messages, Facebook posts and, in some areas, bell-ringing protocols; verification of receipt is impossible, and the last full cascade drill logged 2 hours 40 minutes from decision to last barangay.",
        "desiredStrategy": "Automate multi-channel dissemination with delivery receipts under the Community Early Warning Program, integrated with AWARE decision triggers."
      },
      {
        "id": "c-3",
        "outcomeIds": [
          "oo-2"
        ],
        "programIds": [
          "oo-2-pg-3"
        ],
        "criticalSystem": "TIDEWATCH buoy telemetry (vendor portal)",
        "concern": "Buoy telemetry lives in a vendor portal with per-station license fees and no bulk export; researchers cannot access raw observations, and the Authority cannot verify vendor uptime claims independently.",
        "desiredStrategy": "Take ownership of telemetry via the WATCHFUL sensor network and publish the archive through Open Tides under an open data license."
      }
    ],
    "networkDiagrams": [],
    "networkDescription": "The Authority's monitoring estate includes 340 legacy tide gauges reporting over GSM in batch windows, a vendor-locked buoy telemetry portal, and seventeen regional warning desks that receive data by a mix of e-mail and, in two regions, VHF radio. The central CHIMES platform ingests everything overnight; during Typhoon Barangas (2025) the overnight batch meant surge projections used data eleven hours old. Field stations on small islands share satellite time purchased in weekly blocks.",
