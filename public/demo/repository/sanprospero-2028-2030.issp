        "fundingSource": "General Appropriations Act",
        "year1Deliverables": "Verification live with Malinaw; staff trained",
        "year2Deliverables": "Shared inspection schema adopted",
        "year3Deliverables": "",
        "duration": "2028–2029"
      }
    ],
