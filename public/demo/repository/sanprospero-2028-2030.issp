  "part2": {
    "strategicConcerns": [
      {
        "id": "c-1",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-1"
        ],
        "criticalSystem": "Manual frontline transactions",
        "concern": "Every transaction is a walk-in; a business renewal means two tricycle trips and an average of 3.5 hours away from the shop, and the municipality's own 2025 citizen feedback card shows 'waiting time' as the top complaint three years running.",
        "desiredStrategy": "Launch the San Prospero Digital Frontline: eBPLS-lite permits and certifications with barangay intake kiosks."
      },
      {
        "id": "c-2",
        "outcomeIds": [
          "oo-2"
        ],
        "programIds": [
          "oo-2-pg-2"
        ],
        "criticalSystem": "Ledger books and bond paper records",
        "concern": "Municipal records since 1998 are ledger books in filing cabinets; a retrospective birth certification requires three staff-days of searching, and the 2024 roof leak destroyed a shelf of ordinances.",
        "desiredStrategy": "Digitize priority record series with a searchable records system under the Records Digitization Program."
      }
    ],
    "networkDiagrams": [],
    "networkDescription": "The municipal hall has one consumer broadband connection shared by office Wi-Fi; records are ledger books and bond paper; requests from residents arrive by walk-in, tricycle-delivered letter, or the municipal Facebook page, whichever is fastest that day. The treasury maintains tax records in a spreadsheet on a shared laptop.",
