  "part1": {
    "legalBasis": "Republic Act No. 11654, creating the Municipality of San Prospero as an independent local government unit.",
    "mandateFunction": "The Municipality of San Prospero delivers basic local government services across 23 barangays: business permits, property tax, civil registry front-line services, health and social welfare, with a municipal hall workforce of roughly 120 personnel.",
    "visionStatement": "A municipality where no resident travels to the hall twice for the same transaction.",
    "missionStatement": "To deliver honest, fast municipal services and bring digital front-liners to every barangay.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Faster municipal transactions for residents",
        "programs": [
          {
            "id": "oo-1-pg-1",
            "name": "Digital Frontline Program"
          }
        ]
      },
      {
        "id": "oo-2",
        "name": "Preserved and searchable municipal records",
        "programs": [
