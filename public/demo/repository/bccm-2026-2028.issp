  "part2": {
    "strategicConcerns": [
      {
        "id": "c-1",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-1"
        ],
        "criticalSystem": "TEMPMON (temperature monitoring exports)",
        "concern": "TEMPMON collects readings from 240 accredited cold rooms but only as end-of-week PDF exports; inspectors discover excursions an average of nine days after they happen, and two vaccine batches in 2025 were written off before any alert fired.",
        "desiredStrategy": "Deploy continuous LoRa-based sensors with a central gateway (Project LAMIG) that alerts inspectors within fifteen minutes of an excursion."
      },
      {
        "id": "c-2",
        "outcomeIds": [
          "oo-2"
        ],
        "programIds": [
          "oo-2-pg-2"
        ],
        "criticalSystem": "COMET (cold storage equipment tracker, spreadsheets)",
        "concern": "The national equipment registry is maintained in seventeen regional spreadsheet variants with no common identifier; the same chiller appears under three different serial formats, and the annual registry reconciliation consumes two person-months.",
        "desiredStrategy": "Consolidate the registry into a single digital system with unique equipment IDs, QR tagging, and inspection history (Registry Digitalization Program)."
      }
    ],
    "networkDiagrams": [],
    "networkDescription": "The Central Office runs a flat 1 Gbps LAN with a single ISP fiber link and a DSL backup that has never been tested under load. Seventeen regional inspection teams connect through consumer-grade LTE routers; temperature excursion reports from accredited facilities arrive as weekly e-mailed PDF exports that staff re-encode into a shared spreadsheet. The equipment registry lives on a single on-premise server protected by one aging UPS.",
