  "part1": {
    "legalBasis": "Republic Act No. 11988 (Cold Chain Integrity Act of 2024), which created the Bureau of Cold Chain Management under the Department of Trade, with authority to set, monitor and enforce temperature-controlled storage and transport standards for health and food commodities.",
    "mandateFunction": "The BCCM regulates and monitors the national cold chain: it accredits cold storage facilities, inspects refrigerated transport, maintains the national registry of cold chain equipment, and coordinates with health and food safety agencies on temperature excursion incidents. It operates a central laboratory in Metro Manila and inspection teams across all regions.",
    "visionStatement": "A national cold chain where no vaccine, food commodity or perishable is lost to a break in temperature integrity.",
    "missionStatement": "To set and enforce cold chain standards, maintain an accurate national equipment registry, and provide regulators and the public with reliable, near-real-time visibility of cold chain conditions.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Reduced temperature-excursion losses across the national cold chain",
        "programs": [
          {
            "id": "oo-1-pg-1",
            "name": "Cold Room Monitoring Program"
          },
          {
            "id": "oo-1-pg-2",
            "name": "Excursion Response and Traceback Program"
          }
        ]
      },
      {
        "id": "oo-2",
        "name": "Complete and current national registry of cold chain equipment",
        "programs": [
          {
            "id": "oo-2-pg-1",
            "name": "Registry Digitalization Program"
          }
        ]
      },
      {
        "id": "oo-3",
        "name": "Strengthened BCCM regulatory and inspection capability",
        "programs": [
          {
            "id": "oo-3-pg-1",
            "name": "Inspector Enablement Program"
          }
        ]
      }
    ],
    "cioName": "Chief Ramil D. Espejo",
