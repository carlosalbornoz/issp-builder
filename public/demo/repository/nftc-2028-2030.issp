  "part1": {
    "legalBasis": "Republic Act No. 12034 (Food Supply Chain Traceability Act of 2025), creating the National Food Traceability Council to operate the national traceability registry for high-value agricultural and marine commodities.",
    "mandateFunction": "The NFTC operates the national traceability registry for high-value commodities, accredits traceability service providers, runs field inspection and sampling programs, and coordinates traceback investigations during food safety incidents.",
    "visionStatement": "Every high-value commodity traceable from farm or dock to fork within hours, not weeks.",
    "missionStatement": "To operate a trustworthy national traceability registry and inspection service that protects consumers and opens premium markets for producers.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Rapid, reliable traceback during food safety incidents",
        "programs": [
          {
            "id": "oo-1-pg-1",
            "name": "National Traceability Registry Program"
          }
        ]
      },
      {
        "id": "oo-2",
        "name": "Digitally capable inspection and laboratory operations",
        "programs": [
          {
            "id": "oo-2-pg-1",
            "name": "Inspector Enablement Program"
          }
        ]
      },
      {
        "id": "oo-3",
        "name": "Interoperable food supply chain data",
        "programs": [
          {
            "id": "oo-3-pg-1",
            "name": "Supply Chain Data Program"
          }
        ]
      }
    ],
    "cioName": "Dir. Alfonso L. Bumanglag",
    "cioPosition": "Director III — ICT Service",
    "cioUnit": "ICT Service",
