  "part2": {
    "strategicConcerns": [
      {
        "id": "c-1",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-1"
        ],
        "criticalSystem": "FTS-1 registry (FoxPro)",
        "concern": "The registry of registered establishments still runs on FoxPro; entity resolution during the 2025 mango pulp incident required nine staff-days of cross-checking three inconsistent lists.",
        "desiredStrategy": "Build the National Traceability Registry (NTR) platform with unique lot IDs and event-level traceability."
      },
      {
        "id": "c-2",
        "outcomeIds": [
          "oo-2"
        ],
        "programIds": [
          "oo-2-pg-2"
        ],
        "criticalSystem": "Field sampling (paper forms)",
        "concern": "Inspectors record samples on paper; results return as PDFs in 2–3 weeks, and one in five samples cannot be matched to its establishment record at entry.",
        "desiredStrategy": "Equip inspectors with mobile sampling tools under the Inspector Mobility Program."
      }
    ],
    "networkDiagrams": [],
    "networkDescription": "The Council's systems estate is thin: a FoxPro-era registry of registered establishments, a WordPress permits portal, and traceback investigations that run on e-mail chains. Field inspectors carry paper sampling forms; laboratory results return as PDFs after two to three weeks. The central office shares a building network with two other agencies.",
