    "internalProjects": [
      {
        "id": "p-ntr",
        "title": "National Traceability Registry (NTR) Platform",
        "description": "Builds the event-level traceability registry with unique establishment and lot IDs, custody events, traceback query tools and verification APIs — replacing the FoxPro registry.",
        "objectives": "1. NTR live with establishments migrated by 2029\n2. Event-level custody tracking for all registered commodities\n3. Traceback query time under 24 hours",
        "projectType": "IS_DRIVEN",
        "linkedSystemIds": [
          "ps-ntr"
        ],
        "strategicAlignment": [
          "E-Government Master Plan",
          "Public Investment Program"
        ],
        "harmonizationFramework": [
          "National Prioritization",
          "Interoperability Framework"
        ],
        "implementingUnit": "ICT Service",
        "fundingSource": "General Appropriations Act",
        "year1Deliverables": "Registry core live; establishments migrated; first commodity events flowing",
        "year2Deliverables": "Custody events across the full pilot commodity set; traceback queries under 24h",
        "year3Deliverables": "",
        "duration": "2028–2029"
      },
      {
        "id": "p-inspect",
        "title": "Inspector Mobility and Field Sampling Program",
        "description": "Equips field inspectors with rugged mobile tools: offline sampling capture, lot scanning and direct laboratory intake, replacing paper forms and PDF results.",
        "objectives": "1. Mobile sampling live for all inspection teams by 2028\n2. Sample-to-establishment match rate above 98%\n3. Laboratory result turnaround halved",
        "projectType": "STANDALONE",
        "linkedSystemIds": [
          "ps-fieldkit"
        ],
        "strategicAlignment": [
          "E-Government Master Plan"
        ],
        "harmonizationFramework": [
          "Resource Optimization"
        ],
        "implementingUnit": "Inspection Bureau",
        "fundingSource": "General Appropriations Act",
        "year1Deliverables": "All inspection teams equipped; mobile sampling live; lab intake direct",
        "year2Deliverables": "",
        "year3Deliverables": "",
        "duration": "2028"
      }
    ],
    "crossAgencyProjects": [
      {
        "id": "cx-ctb",
        "title": "Cold Chain Traceability Backbone (CTB) — NFTC share",
        "description": "The Council's share of CTB: consuming cold chain custody events into the NTR and co-chairing the shared data standards working group.",
        "objectives": "1. Ingest CTB custody events into NTR by 2028\n2. Co-chair standards working group\n3. Joint traceback exercise with BCCM annually",
        "projectType": "IS_DRIVEN",
        "linkedSystemIds": [],
        "strategicAlignment": [
          "Program Convergence Budgeting",
          "E-Government Master Plan"
        ],
        "harmonizationFramework": [
          "Interoperability Framework",
          "Cross-Agency Collaboration"
        ],
        "implementingUnit": "ICT Service",
        "leadAgency": "Bureau of Cold Chain Management",
        "implementingAgencies": "Cold Chain Traceability Backbone (CTB)",
        "fundingSource": "General Appropriations Act",
        "year1Deliverables": "CTB event ingestion live; first joint traceback exercise completed",
        "year2Deliverables": "Standards v1.1 adopted (transport segment); sandbox for research partners",
        "year3Deliverables": "Program review and stewardship handover",
        "duration": "2028–2030"
      }
    ],
