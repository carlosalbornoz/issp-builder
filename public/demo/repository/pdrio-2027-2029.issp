  "part2": {
    "strategicConcerns": [
      {
        "id": "c-1",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-1"
        ],
        "criticalSystem": "PRISM (Policy Registry & Insurance Servicing Mainframe)",
        "concern": "Payout computation runs as an overnight batch on PRISM; after Typhoon Barangas, nineteen LGUs waited 18 days for payouts because trigger data arrived as scanned documents that had to be re-keyed before the batch could price them.",
        "desiredStrategy": "Replace manual trigger intake with automated hazard-data feeds (RAPIDE) and a modern claims platform under Project UNDERWRITE, targeting payout within 7 days of trigger."
      },
      {
        "id": "c-2",
        "outcomeIds": [
          "oo-2"
        ],
        "programIds": [
          "oo-2-pg-2"
        ],
        "criticalSystem": "Exposure models (single workstation)",
        "concern": "National exposure models are maintained on one licensed workstation; two pricing seasons have been delayed by queueing, and no one else can run the full model stack.",
        "desiredStrategy": "Migrate modeling to a governed geospatial data warehouse with elastic compute and versioned model runs."
      }
    ],
    "networkDiagrams": [],
    "networkDescription": "The Office operates from one central building with a well-maintained but aging network. The PRISM policy mainframe sits in a glass-walled machine room that features in visitor tours; its batch windows dictate office hours for policy servicing. Actuarial models run on one licensed workstation; the modeling team queues for it during pricing season. A single cloud tenancy hosts the public product pages.",
