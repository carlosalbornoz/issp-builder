    "internalProjects": [
      {
        "id": "p-underwrite",
        "title": "Project UNDERWRITE — Unified Data Environment for Risk-weighted Writing, Rating, Actuarics & Transaction Exchange",
        "description": "Builds the modern policy and claims platform: LGU self-service enrolment, automated trigger ingestion from RAPIDE, straight-through payout computation, and PRISM decommissioning.",
        "objectives": "1. LGU self-service enrolment live by 2028\n2. Automated trigger ingestion for all covered perils\n3. Median payout time from trigger to release: 7 days\n4. PRISM decommissioned by end of 2028",
        "projectType": "IS_DRIVEN",
        "linkedSystemIds": [
          "ps-underwrite"
        ],
        "strategicAlignment": [
          "E-Government Master Plan",
          "National Cybersecurity Plan"
        ],
        "harmonizationFramework": [
          "National Prioritization",
          "Interoperability Framework"
        ],
        "implementingUnit": "ICT Division",
        "fundingSource": "General Appropriations Act",
        "year1Deliverables": "Core platform live; 3 pilot provinces enrolled; automated windstorm triggers",
        "year2Deliverables": "All perils automated; national enrolment wave; PRISM decommissioned",
        "year3Deliverables": "",
        "duration": "2027–2028"
      },
      {
        "id": "p-geo",
        "title": "Geospatial Risk Data Warehouse",
        "description": "Consolidates exposure, hazard and claims data into a governed warehouse with versioned model runs, ending single-workstation model dependency.",
        "objectives": "1. Warehouse live with national exposure data by 2027\n2. Versioned, reviewable model runs\n3. Elastic compute for pricing season",
        "projectType": "IS_DRIVEN",
        "linkedSystemIds": [
          "ps-geowarehouse"
        ],
        "strategicAlignment": [
          "Public Investment Program"
        ],
        "harmonizationFramework": [
          "Resource Optimization",
          "Scalability and Sustainability"
        ],
        "implementingUnit": "Risk Management Division",
        "fundingSource": "General Appropriations Act",
        "year1Deliverables": "Warehouse live; exposure data migrated; first versioned model run",
        "year2Deliverables": "Claims and hazard data integrated; peer review workflow live",
        "year3Deliverables": "Elastic pricing-season compute validated; workstation dependency retired",
        "duration": "2027–2029"
      }
    ],
    "crossAgencyProjects": [
      {
        "id": "cx-rapide",
        "title": "RAPIDE — Real-time Analytics Platform for Inter-agency Disaster Events (PDRIO share)",
        "description": "The Office's share of RAPIDE: consuming NCRA hazard feeds as automated payout triggers and contributing exposure aggregates back to the exchange.",
        "objectives": "1. Automated trigger feeds for windstorm and surge perils by 2027\n2. Exposure aggregates published to partner agencies\n3. Joint payout drills each season",
        "projectType": "IS_DRIVEN",
        "linkedSystemIds": [],
        "strategicAlignment": [
          "Program Convergence Budgeting",
          "E-Government Master Plan"
        ],
        "harmonizationFramework": [
          "Interoperability Framework",
          "Cross-Agency Collaboration"
        ],
        "implementingUnit": "ICT Division",
        "leadAgency": "National Coastal Resilience Authority",
        "implementingAgencies": "RAPIDE — Real-time Analytics Platform for Inter-agency Disaster Events",
        "fundingSource": "General Appropriations Act",
        "year1Deliverables": "Windstorm trigger feed live; first automated test payout executed in drill",
        "year2Deliverables": "Surge trigger feed live; exposure aggregates published",
        "year3Deliverables": "",
        "duration": "2027–2028"
      }
    ],
