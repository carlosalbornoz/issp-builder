  "part1": {
    "legalBasis": "Republic Act No. 11954 (Local Government Disaster Risk Insurance Act of 2024), creating the Philippine Disaster Risk Insurance Office to design, price and administer parametric insurance pools for provinces, cities and municipalities.",
    "mandateFunction": "The PDRIO designs parametric insurance products for LGU assets, pools and prices risk across provinces, administers payouts triggered by official hazard data, and advises on risk transfer for public infrastructure. It maintains exposure models for roads, buildings, schools and hospitals nationwide.",
    "visionStatement": "Local governments that recover from disasters in weeks, not years, because risk was transferred before the storm.",
    "missionStatement": "To pool, price and pay disaster risk for local governments with actuarially sound, transparent and fast-settling parametric products.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Faster, fairer parametric payouts to LGUs",
        "programs": [
          {
            "id": "oo-1-pg-1",
            "name": "Parametric Payout Program"
          }
        ]
      },
      {
        "id": "oo-2",
        "name": "Actuarially sound national risk data",
        "programs": [
          {
            "id": "oo-2-pg-1",
            "name": "Risk Data Program"
          }
        ]
      },
      {
        "id": "oo-3",
        "name": "Capable and secure PDRIO operations",
        "programs": [
          {
            "id": "oo-3-pg-1",
            "name": "Operations Strengthening Program"
          }
        ]
      }
    ],
    "cioName": "Dir. Anselmo R. Quijano",
