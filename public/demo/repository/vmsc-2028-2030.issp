  "part1": {
    "legalBasis": "Republic Act No. 11322, establishing the Visayas Maritime State College with mandates in maritime higher education, simulator-based training, and maritime research.",
    "mandateFunction": "VMSC delivers maritime higher education and simulator-based training for the domestic shipping industry, runs maritime research programs, and provides continuing education for seafarers through its extension campus network.",
    "visionStatement": "A maritime college whose graduates train on simulators as modern as the ships they will sail.",
    "missionStatement": "To provide quality maritime education and research supported by modern simulation, laboratory and campus systems.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Globally benchmarked simulator training",
