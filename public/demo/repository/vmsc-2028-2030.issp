  "part2": {
    "strategicConcerns": [
      {
        "id": "c-1",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-1"
        ],
        "criticalSystem": "Full mission bridge simulator (2012)",
        "concern": "The 2012 simulator cannot run current exercise databases or log trainee performance electronically; instructors assess by checklist on paper, and two shipping companies have moved contract training to a competitor with newer suites.",
        "desiredStrategy": "Refresh the simulator estate with modern bridge suites and performance logging under the Simulator Modernization Program."
      },
      {
        "id": "c-2",
        "outcomeIds": [
          "oo-2"
        ],
        "programIds": [
          "oo-2-pg-2"
        ],
        "criticalSystem": "SIS (in-house PHP)",
        "concern": "The one-programmer student information system has no test environment and no documentation; enrolment peaks are survived, not managed, and simulator scheduling is a whiteboard.",
        "desiredStrategy": "Integrate campus systems under ONE-VMSC with a supported SIS core, scheduling and single sign-on."
      }
    ],
    "networkDiagrams": [],
    "networkDescription": "The main campus network is adequate for e-mail and browsing but not for the simulator building, whose full-mission bridge suite (acquired 2012) cannot run current exercise databases. The student information system is an in-house PHP application maintained by one programmer; the library runs Koha; research datasets live on individual external drives labeled by principal investigator.",
