  "part1": {
    "legalBasis": "Republic Act No. 11245, converting the highland agri-forestry school into a state college, with instruction, research and extension mandates in sustainable highland agriculture and community forestry.",
    "mandateFunction": "HAFSC provides higher education in agriculture, forestry and environmental science for highland farming communities; runs research on climate-resilient upland farming; and delivers extension services to farmer cooperatives across three provinces through its extension network and demonstration farms.",
    "visionStatement": "A state college whose farms, laboratories and classrooms operate as one connected campus serving highland farming communities.",
    "missionStatement": "To deliver quality agri-forestry education, research and extension backed by reliable information systems and campus connectivity.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Efficient and transparent academic administration",
        "programs": [
