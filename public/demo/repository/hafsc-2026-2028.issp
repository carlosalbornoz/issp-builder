  "part2": {
    "strategicConcerns": [
      {
        "id": "c-1",
        "outcomeIds": [
          "oo-1"
        ],
        "programIds": [
          "oo-1-pg-1"
        ],
        "criticalSystem": "Enrolment records (spreadsheets)",
        "concern": "Enrolment runs on a registrar-maintained spreadsheet gridlocked to one workstation; during enrolment week the queue for the single encoding station wraps around the registrar's corridor, and sectioning is finalized by acetate boards.",
        "desiredStrategy": "Deploy an integrated student information system with self-service enrolment and faculty grade capture."
      },
      {
        "id": "c-2",
        "outcomeIds": [
          "oo-2"
        ],
        "programIds": [
          "oo-2-pg-2"
        ],
        "criticalSystem": "Extension training records (manual)",
        "concern": "Extension training for cooperatives is delivered in person with printed modules; farmers who cannot travel lose access entirely, and training completion records exist only on attendance sheets.",
        "desiredStrategy": "Launch an e-extension learning platform with offline-capable modules mapped to the college's demonstration farm calendar."
      },
      {
        "id": "c-3",
        "outcomeIds": [
          "oo-3"
        ],
        "programIds": [
          "oo-3-pg-3"
        ],
        "criticalSystem": "Campus network (unmanaged)",
        "concern": "The unmanaged campus network has no segregation between the registrar's server, laboratory machines and dormitory Wi-Fi; a ransomware scare in the computer laboratory in 2025 was contained by unplugging the building.",
        "desiredStrategy": "Execute the campus network modernization and cybersecurity hardening project: fiber backbone, managed segmentation, central authentication and backups."
      }
    ],
    "networkDiagrams": [],
    "networkDescription": "The main campus network is a mix of unmanaged switches and home routers installed building-by-building over fifteen years; two remote demonstration farms have no connectivity at all and report by SMS. The student information system runs on a single tower server in the registrar's storeroom, cooled by an electric fan. Backup is an external hard drive rotated weekly to the vault, when staff remember.",
