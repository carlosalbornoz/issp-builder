  "part1": {
    "legalBasis": "Republic Act No. 11893 (Cooperative Standards Commission Act of 2023), creating the Commission on Cooperative Standards to maintain the national registry of cooperatives, set governance and audit standards, and administer the cooperative audit framework.",
    "mandateFunction": "The CCS maintains the national registry of cooperatives, sets governance, financial reporting and audit standards for the sector, schedules and quality-assures cooperative audits, and publishes sector statistics.",
    "visionStatement": "A cooperative sector the public can trust, on a registry anyone can verify.",
    "missionStatement": "To maintain an authoritative cooperative registry, set clear standards, and run a credible audit framework.",
    "orgOutcomes": [
      {
        "id": "oo-1",
        "name": "Authoritative, verifiable cooperative registry",
        "programs": [
          {
            "id": "oo-1-pg-1",
            "name": "Registry and Audit Ledger Program"
          }
        ]
      },
      {
        "id": "oo-2",
        "name": "Clear, teachable standards for the sector",
        "programs": [
          {
            "id": "oo-2-pg-1",
            "name": "Standards Dissemination Program"
          }
        ]
      },
      {
        "id": "oo-3",
        "name": "Modern, secure Commission operations",
        "programs": [
          {
            "id": "oo-3-pg-1",
            "name": "Commission Modernization Program"
          }
        ]
      }
    ],
    "cioName": "Dir. Katrina S. Almendral",
